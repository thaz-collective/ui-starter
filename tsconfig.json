{
  "extends": [
    "@thaz/typescript-config/bundler.json",
    "@thaz/typescript-config/lib-dom.json",
    "@thaz/typescript-config/paths.json",
    "@thaz/typescript-config/react.json"
  ],
  "include": ["src", "vite.config.ts", "content-collections.config.ts", ".content-collections/generated"],
  "compilerOptions": {
    "types": ["node", "vite-plus/client"],
    "paths": {
      "#src/*": ["${configDir}/src/*"],
      "#test/*": ["${configDir}/test/*"],
      "#mock/*": ["${configDir}/mock/*"],
      "content-collections": ["./.content-collections/generated"]
    }
  }
}
