    "@tanstack/react-virtual": "catalog:",
    "@tanstack/store": "catalog:",
    "@thaz/form-util": "catalog:",
    "@thaz/temporal-util": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "tailwind-variants": "catalog:",
    "temporal-polyfill": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
