{
  "name": "@thaz/ui-starter",
  "version": "1.0.0-rc.1",
  "description": "UI template components and building point for other thaz-collective libraries",
  "homepage": "https://github.com/thaz-collective/ui-starter#readme",
  "bugs": {
    "url": "https://github.com/thaz-collective/ui-starter/issues"
