  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaz-collective/ui-starter.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "intent": "vpx @tanstack/intent@latest",
    "taze": "vpx taze@latest -Ilwr --maturity-period 3",
    "taze:major": "vpx taze@latest major -Ilwr --maturity-period 3",
    "taze:minor": "vpx taze@latest minor -Ilwr --maturity-period 3",
    "taze:patch": "vpx taze@latest patch -Ilwr --maturity-period 3",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@internationalized/date": "catalog:",
    "@tanstack/react-form": "catalog:",
